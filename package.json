{
  "name": "@mharj/openweathermap",
  "version": "0.1.4",
  "description": "Open Weather API Client",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "types": {
      "import": "./dist/index.d.mts",
      "require": "./dist/index.d.cts"
    },
    "import": "./dist/index.mjs",
    "require": "./dist/index.cjs",
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "docs": "typedoc",
    "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
    "lint": "biome check",
    "validate": "tsgo --noEmit --project tsconfig.test.json"
  },
  "files": [
    "dist"
  ],
  "repository": "github:mharj/openweathermap",
  "keywords": [
    "weather",
    "api",
    "client"
  ],
  "author": "mharj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mharj/ts-openweather/issues"
  },
  "homepage": "https://github.com/mharj/ts-openweather#readme",
  "devDependencies": {
    "@avanio/expire-cache": "^0.7.0",
    "@avanio/logger-like": "^0.2.13",
    "@biomejs/biome": "^2.5.15",
    "@luolapeikko/cache-types": "^0.0.10",
    "@luolapeikko/result-option": "^2.4.0",
    "@luolapeikko/ts-common": "^1.1.6",
    "@types/node": "^24.19.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.3",
    "c8": "^12.0.0",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-dt-links": "^2.0.75",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-zod": "^1.4.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@luolapeikko/cache-types": "^0.0",
    "@luolapeikko/result-option": ">= 1",
    "@luolapeikko/ts-common": ">= 0.0.1",
    "zod": "^4"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
